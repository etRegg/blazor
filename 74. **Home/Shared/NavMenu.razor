@inject NavigationManager Navigation

<div class="top-row pl-4 navbar navbar-dark bg-dark">
  <a href="" class="navbar-brand">BlazorApp</a>
  <button class="navbar-toggler" @onclick="ToggleNavMenu">
    <span class="navbar-toggler-icon"></span>
  </button>
</div>

<div class="nav-menu collapse d-md-inline-flex flex-column pl-3">
  <NavLink class="nav-link text-dark" href="" Match="NavLinkMatch.All">
    <span class="oi oi-list-rich" aria-hidden="true"></span> Home
  </NavLink>
  <NavLink class="nav-link text-dark" href="/public">
    <span class="oi oi-list-rich" aria-hidden="true"></span> Public Page
  </NavLink>
</div>

<div @onclick="ToggleNavMenu" class="nav-menu collapse navbar-collapse d-md-inline-flex flex-column pl-3">
  <NavLink class="nav-link text-dark" href="/login">
    <span class="oi oi-list-rich" aria-hidden="true"></span> Login
  </NavLink>
  <NavLink class="nav-link text-dark" href="/register">
    <span class="oi oi-list-rich" aria-hidden="true"></span> Register
  </NavLink>
</div>

@code {
  private bool collapseNavMenu = true;

  private void ToggleNavMenu()
  {
    collapseNavMenu = !collapseNavMenu;
  }
}
